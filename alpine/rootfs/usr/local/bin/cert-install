#!/bin/ash

set -eu

################################################################################

main () {
    if [ -z "${1:-}" ]; then
        return
    fi

    domain="${1:-}"
    cert="${domain#*.}.crt"

    if ! command -v openssl; then
        echo "o Installing OpenSSL"
        apk add --no-cache openssl
        remove=openssl
    fi

    echo "o Downloading '${cert}' from https://${domain}"
    openssl s_client                                                           \
            -showcerts                                                         \
            -servername "${domain}"                                            \
            -connect "${domain}:443" 2>/dev/null </dev/null                    \
        | sed -ne '/-BEGIN CERTIFICATE-/,/-END CERTIFICATE-/p' | {
        openssl x509 > /dev/null
        openssl x509
    } > "/usr/local/share/ca-certificates/${cert}"

    echo "o Installing ${cert}"
    update-ca-certificates

    if [ "${remove}" = openssl ]; then
        echo "o Un-installing OpenSSL"
        apk del --purge openssl
    fi
}

main "${@}"; exit
