#!/bin/ash

set -eux

: "${CERT_INSTALL_DOMAIN:=}"

################################################################################

error () {
    echo "ERROR: ${*}" >/dev/stderr
}

fail () {
    error "${*}"
    echo
    usage
    return 2
}

################################################################################

usage () {
    cat <<EOM
Usage: $(basename "${0}") <FQDN> [NAME]

Install the lowest cert in the chain from a host.
EOM
}

main () {
    domain="${1:-${CERT_INSTALL_DOMAIN:-}}"
    name="${2:-${domain#*.}}"

    if [ -z "${domain}" ]; then
        fail "Missing argument DOMAIN"
    fi

    if [ -z "${name}" ]; then
        fail "Missing argument NAME"
    fi

    # echo ============
    # openssl s_client                                                           \
        #         -showcerts                                                         \
        #         -servername "${domain}"                                            \
        #         -connect "${domain}:443" 2>/dev/null </dev/null
    # echo ============
    # return
    openssl s_client                                                           \
            -showcerts                                                         \
            -servername "${domain}"                                            \
            -connect "${domain}:443" 2>/dev/null </dev/null                    \
        | sed -ne '/-BEGIN CERTIFICATE-/,/-END CERTIFICATE-/p' | {
        openssl x509 > /dev/null
        openssl x509
    } > "/usr/local/share/ca-certificates/${name}.crt"

    update-ca-certificates
}

main "${@}"; exit
