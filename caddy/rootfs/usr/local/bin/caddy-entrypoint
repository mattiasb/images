set -eu

if [ -n "${X_CADDY_UMASK}" ]; then
    umask "${X_CADDY_UMASK}"
fi

cmd="${1:-}"
case "${cmd}" in
    ''|-*)      cmd="/usr/local/bin/caddy-run"                                ;;
    run|reload) cmd="/usr/local/bin/caddy-${cmd}"; shift                      ;;
    *)          shift                                                         ;;
esac

exec "${cmd}" "${@}"
