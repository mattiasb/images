set -eu

logjq () {
    case "${X_CADDY_LOG_JQ_DEBUG:-0}" in
        1|true) LOG_JQ_DEBUG='tee /dev/stderr'                                ;;
        *)      LOG_JQ_DEBUG='cat'                                            ;;
    esac

    LOG_JQ=/usr/local/share/caddy/log.jq
    if [ -f /etc/caddy/log.jq ]; then
        LOG_JQ=/etc/caddy/log.jq
    fi

    ( trap '' INT; ${LOG_JQ_DEBUG} | jq -rf "${LOG_JQ}" )
}

################################################################################

set -- run "${@}"                                                              \
    ${X_CADDY_CONFIG:+--config="${X_CADDY_CONFIG}"}                            \
    ${X_CADDY_CONFIG_ADAPTER:+--adapter="${X_CADDY_CONFIG_ADAPTER}"}

case "${X_CADDY_LOG_JQ:-0}" in
    1|true) exec /usr/bin/caddy "${@}" | logjq                                ;;
    *)      exec /usr/bin/caddy "${@}"                                        ;;
esac
