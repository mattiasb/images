#!/bin/sh

# Copyright 2026, Mattias Bengtsson <mattias.jc.bengtsson@gmail.com>
# SPDX-License-Identifier: GPL-3.0-only

if [ "${X_AUTHELIA_LOG_JQ:-0}" = "0" ]; then
    exec authelia
fi

export AUTHELIA_LOG_FORMAT=json

if [ -f /etc/authelia/log.jq ]; then
    LOG_JQ=/etc/authelia/log.jq
else
    LOG_JQ=/usr/local/share/authelia/log.jq
fi

# Even when we set log.format=json the first two lines will *still* be logfmt.
LOGFMT_RX='time=".+?" level=([a-z]+) msg="(.+?)"'

exec authelia 2>&1                                                             \
    | sed -r 's|'"${LOGFMT_RX}"'|{"level":"\1","msg":"\2"}|'                   \
    | jq -rf "${LOG_JQ}"
