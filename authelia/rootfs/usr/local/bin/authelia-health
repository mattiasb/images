# From: https://github.com/authelia/authelia/blob/fef15f6b8adb/healthcheck.sh

if [ "${X_AUTHELIA_HEALTHCHECK:-0}" = "0" ]; then
  exit 0
fi

if [ -z "${X_AUTHELIA_HEALTHCHECK_SCHEME}" ]; then
  X_AUTHELIA_HEALTHCHECK_SCHEME=http
fi

if [ -z "${X_AUTHELIA_HEALTHCHECK_HOST}" ]; then
  X_AUTHELIA_HEALTHCHECK_HOST=localhost
fi

if [ -z "${X_AUTHELIA_HEALTHCHECK_PORT}" ]; then
  X_AUTHELIA_HEALTHCHECK_PORT=9091
fi

URL="${X_AUTHELIA_HEALTHCHECK_SCHEME}://${X_AUTHELIA_HEALTHCHECK_HOST}"
URL="${URL}:${X_AUTHELIA_HEALTHCHECK_PORT}/api/health"

exec curl --show-error --silent --fail "${URL}"
